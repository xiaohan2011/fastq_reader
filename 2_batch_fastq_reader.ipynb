    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Batch FASTQ reader\\n\",\n",
    "    \"\\n\",\n",
    "    \"Scan the selected FASTQ folder (no subfolders), generate a length-sorted CSV and histogram for every file, and align to a matching FASTA or SnapGene `.dna` reference when available.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Match references by the complete leading number: `1132.fastq.gz` matches `1132 LPPC EE R-S.dna`. Multiple matching references produce QC only and an ambiguity in the batch report. Missing references also produce QC only.\\n\",\n",
    "    \"\\n\",\n",
    "    \"All outputs go directly into one separate output folder. Completed samples are skipped; set `OVERWRITE = True` to rebuild them. Failed or changed samples with existing outputs also require overwrite. The original input files are never modified.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Install Python dependencies with `python -m pip install -r requirements-notebook.txt`, and install `minimap2` and `samtools` separately for alignment. Open this notebook with its working directory set to the repository folder. In the prepared cloud environment, first run `source /workspace/fastq-reader-local/activate.sh`.\\n\",\n",
    "    \"\\n\",\n",
    "    \"Sequencing-run prefixes are supported: `9M53XY_1_1108-G1.fastq` has sample ID **1108** and automatically matches a reference beginning with `1108`. The run token and barcode are ignored for matching; full FASTQ filenames remain the output/track labels.\\n\"\n",
    "   ],\n",
    "   \"id\": \"batch-1\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-11-13T18:42:40.766429Z\",\n",
    "     \"start_time\": \"2026-11-13T18:42:40.761431Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"FASTQ_DIR = Path('/Volumes/tsienlab/tsienlabspace/INNO-DATA-MOL/5 Sanger&Nanopore/26-11-13 1148 LR/WVW9PV_fastq')\\n\",\n",
    "    \"REFERENCE_DIR = Path('/Users/wangx21/Library/CloudStorage/Dropbox-NYULangoneHealth/Xiaohan Wang/XW_reagents/1_DNA&Protein/1_pXW_record')  # None searches FASTQ_DIR; otherwise Path(\\\"/path/to/reference_folder\\\")\\n\",\n",
    "    \"REFERENCE_FILE = None  # leave None for automatic grouping by FASTQ ID\\n\",\n",
    "    \"OUTPUT_DIR = FASTQ_DIR / \\\"results\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"OVERWRITE = True\\n\",\n",
    "    \"QC_ONLY = False  # True skips reference search and alignment\\n\",\n",
    "    \"BIN_SIZE_BP = 2000\\n\",\n",
    "    \"LOG_Y = False\\n\",\n",
    "    \"THREADS = 4\\n\"\n",
    "   ],\n",
    "   \"id\": \"batch-2\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 5\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-11-13T18:42:56.479351Z\",\n",
    "     \"start_time\": \"2026-11-13T18:42:41.457393Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"import importlib\\n\",\n",
    "    \"import batch_fastq_reader\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Reload after code updates so the kernel uses the current matcher.\\n\",\n",
    "    \"importlib.invalidate_caches()\\n\",\n",
    "    \"batch_fastq_reader = importlib.reload(batch_fastq_reader)\\n\",\n",
    "    \"print(\\\"Using batch code:\\\", batch_fastq_reader.__file__)\\n\",\n",
    "    \"run_batch = batch_fastq_reader.run_batch\\n\",\n",
    "    \"\\n\",\n",
    "    \"report = run_batch(\\n\",\n",
    "    \"    fastq_dir=FASTQ_DIR,\\n\",\n",
    "    \"    reference_dir=REFERENCE_DIR,\\n\",\n",
    "    \"    reference_file=REFERENCE_FILE,\\n\",\n",
    "    \"    output_dir=OUTPUT_DIR,\\n\",\n",
    "    \"    overwrite=OVERWRITE,\\n\",\n",
    "    \"    qc_only=QC_ONLY,\\n\",\n",
    "    \"    bin_size=BIN_SIZE_BP,\\n\",\n",
    "    \"    log_y=LOG_Y,\\n\",\n",
    "    \"    threads=THREADS,\\n\",\n",
    "    \")\\n\",\n",
    "    \"display(report)\\n\"\n",
    "   ],\n",
    "   \"id\": \"batch-3\",\n",
    "   \"outputs\": [\n",
